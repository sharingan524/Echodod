// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========================================
// User & Account Management
// ========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  organizations OrganizationMember[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  // oauth, email
  provider          String  // google, github, email
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ========================================
// Multi-tenant Organization
// ========================================

model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  plan           String   @default("pending") // pending, basic, standard, premium
  subscriptionId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members               OrganizationMember[]
  phoneNumbers          PhoneNumber[]
  apiKeys               ApiKey[]
  communicationLogs     CommunicationLog[]
  webhooks              Webhook[]
  billingInfo           BillingInfo?
  auditLogs             AuditLog[]
  clientProfile         ClientProfile?
  businessHours         BusinessHours[]
  holidaySchedules      HolidaySchedule[]
  greetingMessages      GreetingMessage[]
  serviceConfigs        ServiceConfig[]
  implementationTickets ImplementationTicket[]
  maintenanceLogs       MaintenanceLog[]
  awsCredential         AwsCredential?
}

model OrganizationMember {
  id             String   @id @default(cuid())
  role           String   @default("member") // owner, admin, member
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

// ========================================
// Phone Numbers
// ========================================

model PhoneNumber {
  id             String   @id @default(cuid())
  phoneNumber    String   @unique
  provider       String   // aws-connect, twilio
  providerSid    String?
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ========================================
// Communication Logs
// ========================================

model CommunicationLog {
  id             String   @id @default(cuid())
  externalId     String   @unique
  channel        String   // phone, chat, sms, email
  direction      String   // inbound, outbound
  contactInfo    String   // phone number, email address, etc.
  subject        String?  // for email/chat
  content        String   @db.Text
  duration       Int?     // seconds, nullable for non-call channels
  outcome        String   // resolved, escalated, missed, delivered, bounced
  status         String   // completed, failed, in-progress, sent
  metadata       Json?    // Additional structured data
  provider       String   // aws-connect, pinpoint, ses
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([channel])
}

// ========================================
// API Keys
// ========================================

model ApiKey {
  id             String    @id @default(cuid())
  name           String
  keyHash        String    @unique
  keyPrefix      String    // First 8 chars for display
  lastUsedAt     DateTime?
  organizationId String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ========================================
// Webhooks
// ========================================

model Webhook {
  id             String   @id @default(cuid())
  url            String
  events         String[] // communication.received, communication.sent, service.status_changed
  isActive       Boolean  @default(true)
  secret         String   // For signature verification
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ========================================
// Billing
// ========================================

model BillingInfo {
  id                    String    @id @default(cuid())
  organizationId        String    @unique
  stripeCustomerId      String    @unique
  paymentMethodId       String?
  implementationFee     Int       @default(0) // cents
  monthlyMaintenanceFee Int       @default(0) // cents
  implementationPaidAt  DateTime?
  serviceStatus         String    @default("pending") // pending, active, suspended, terminated
  billingCycle          DateTime
  paymentFailedAt       DateTime? // Set when payment fails; cleared on success
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ========================================
// Client Profile & Business Info
// ========================================

model ClientProfile {
  id             String   @id @default(cuid())
  organizationId String   @unique
  businessName   String
  address        String?
  phone          String?
  email          String?
  website        String?
  description    String?  @db.Text
  industry       String?
  timezone       String   @default("America/Chicago")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BusinessHours {
  id             String   @id @default(cuid())
  organizationId String
  dayOfWeek      Int      // 0=Sunday, 6=Saturday
  openTime       String   // "09:00" format
  closeTime      String   // "17:00" format
  isClosed       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dayOfWeek])
}

model HolidaySchedule {
  id               String   @id @default(cuid())
  organizationId   String
  date             DateTime
  name             String
  isClosed         Boolean  @default(true)
  specialOpenTime  String?
  specialCloseTime String?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
}

model GreetingMessage {
  id             String   @id @default(cuid())
  organizationId String
  channel        String   // phone, chat, email, sms
  message        String   @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channel])
}

// ========================================
// Service Configuration (Admin-managed)
// ========================================

model ServiceConfig {
  id             String   @id @default(cuid())
  organizationId String
  serviceType    String   // connect, pinpoint, ses, lex, etc.
  status         String   @default("pending") // pending, configuring, active, inactive
  awsAccountId   String?
  awsRegion      String?
  configDetails  Json?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ========================================
// Implementation & Maintenance (Admin-managed)
// ========================================

model ImplementationTicket {
  id                String    @id @default(cuid())
  organizationId    String
  title             String
  description       String?   @db.Text
  status            String    @default("pending") // pending, in_progress, completed, cancelled
  priority          String    @default("normal") // low, normal, high, urgent
  assignedTo        String?   // userId of SV team member
  provisioningSteps Json?     // Array of { id, name, status, startedAt, completedAt, error, result }
  provisioningMode  String?   // "auto" | "manual"
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([assignedTo])
}

model MaintenanceLog {
  id             String   @id @default(cuid())
  organizationId String
  description    String   @db.Text
  performedBy    String   // userId
  type           String   // routine, fix, update, emergency
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ========================================
// Audit Logging
// ========================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  action         String   // member.invited, member.removed, member.role_changed, business_hours.updated, greeting.updated, profile.updated, service.configured, ticket.created, ticket.completed, client.approved, client.suspended, api_key.created, api_key.deleted
  targetType     String?  // user, service, ticket, profile, phone_number
  targetId       String?
  metadata       Json?    // Additional context
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId])
}

// ========================================
// AWS Credentials (Per-Organization)
// ========================================

model AwsCredential {
  id              String    @id @default(cuid())
  organizationId  String    @unique
  accessKeyId     String    // Encrypted with AES-256-GCM
  secretAccessKey String    // Encrypted with AES-256-GCM
  region          String    @default("us-east-1")
  accountId       String?   // Resolved via STS GetCallerIdentity
  isValid         Boolean   @default(false)
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
